<Window x:Class="DeskProfiles.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DeskProfiles — Preview v0.1.2" Width="700" Height="520" MinWidth="620" MinHeight="460" Background="#161B24" Foreground="#ECF0F6" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Padding" Value="13,8"/><Setter Property="Background" Value="#344155"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F0F4FC"/><Setter Property="FontSize" Value="13"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Window.Resources>
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,20"><TextBlock Text="DeskProfiles" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Safe preview • Layout profiles • No desktop files are moved" Foreground="#AAB7C8" Margin="0,6,0,0"/></StackPanel>
    <Border Grid.Row="1" Background="#252F3F" CornerRadius="8" Padding="15" Margin="0,0,0,15"><StackPanel><TextBlock Text="Active monitor configuration" FontWeight="SemiBold"/><TextBlock x:Name="TopologyText" Margin="0,6,0,0" Foreground="#C7D2E3"/><TextBlock x:Name="TopologyKeyText" FontSize="11" Foreground="#C8D4E5" Margin="0,6,0,0" ToolTip="Exact monitor configuration identity"/></StackPanel></Border>
    <StackPanel Grid.Row="2" Margin="0,0,0,14"><TextBlock Text="Desktop profile" FontWeight="SemiBold" Margin="0,0,0,8"/><DockPanel><Button DockPanel.Dock="Right" Content="+ New profile" Click="AddProfile_Click"/><ComboBox x:Name="ProfileCombo" Height="34" Background="#EAF0F8" Foreground="#111827" SelectionChanged="ProfileCombo_SelectionChanged"/></DockPanel><TextBlock Text="Each profile has separate saved layouts for each monitor setup." Foreground="#AAB7C8" Margin="0,7,0,0"/></StackPanel>
    <StackPanel Grid.Row="3"><WrapPanel Margin="0,8,0,14"><Button Content="Save current layout" Click="Save_Click"/><Button Content="Restore saved layout" Click="Restore_Click"/><Button Content="Undo last restore" Click="Undo_Click"/></WrapPanel><CheckBox x:Name="AutoRestoreBox" Content="Automatically restore when monitor setup changes (opt-in)" IsChecked="False" Checked="AutoRestore_Changed" Unchecked="AutoRestore_Changed"/><TextBlock Margin="0,15,0,0" FontWeight="SemiBold" Text="Activity"/><TextBox x:Name="LogText" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#101722" Foreground="#C8D4E5" BorderThickness="0" Padding="10" MinHeight="150"/></StackPanel>
    <TextBlock Grid.Row="4" Margin="0,12,0,0" Foreground="#F0BD79" TextWrapping="Wrap" Text="Preview limitation: profiles currently save icon positions, not separate desktop files. Turn off 'Auto arrange icons' before restoring."/>
  </Grid>
</Window>

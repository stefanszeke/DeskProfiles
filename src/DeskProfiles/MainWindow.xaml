<Window x:Class="DeskProfiles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskProfiles v0.2.4" Width="940" Height="650" MinWidth="790" MinHeight="540"
        Background="#121821" Foreground="#EDF2F9" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#1D2632"/>
    <SolidColorBrush x:Key="Muted" Color="#B5C1D1"/>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F3F6FB"/><Setter Property="Background" Value="#354559"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,5"/>
      <Setter Property="MinHeight" Value="27"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.43"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#3977BE"/>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EDF2F9"/><Setter Property="FontSize" Value="13"/></Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#EFF4FC"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#31445F"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2A394D"/></Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#1A2330" BorderBrush="#344155" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,16,10,12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,25">
          <TextBlock Text="DeskProfiles" FontSize="23" FontWeight="SemiBold"/>
          <TextBlock Text="Desktop layout manager · v0.2.4" Margin="0,5,0,0" Foreground="{StaticResource Muted}" FontSize="12"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Button Content="+ New profile" Click="AddProfile_Click" Margin="0,0,0,12"/>
          <Button Content="⚙  Settings" Click="SettingsPage_Click" Margin="0,0,0,7"/>
          <Button Content="≡  Activity &amp; Logs" Click="ActivityPage_Click" Margin="0,0,0,12"/>
          <Separator Background="#465469" Margin="0,0,0,12"/>
          <TextBlock Text="SAFE MODE" FontSize="11" FontWeight="Bold" Foreground="#9ECAFA"/>
          <TextBlock Text="Activate restores icon positions if a layout is saved. No desktop files are moved." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="PROFILES" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="4,0,0,12"/>
          <ListBox x:Name="ProfileList" Background="Transparent" BorderThickness="0" SelectionChanged="ProfileList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="●" Foreground="#6DD4A4" VerticalAlignment="Center" Visibility="{Binding ActiveVisibility}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="18,14,18,12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel x:Name="ProfilesHeader" Grid.Row="0" Margin="0,0,0,15">
        <TextBlock x:Name="ProfileTitle" Text="Personal" FontSize="23" FontWeight="SemiBold"/>
        <TextBlock x:Name="ProfileSubtitle" Text="Select a profile to see its settings" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
      </StackPanel>
      <ScrollViewer x:Name="ProfilesPage" Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Background="{StaticResource Panel}" Padding="12" CornerRadius="9" Margin="0,0,0,9">
            <StackPanel>
              <TextBlock Text="Profile" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <TextBlock x:Name="ProfileStateText" Foreground="{StaticResource Muted}" Margin="0,0,0,9"/>
              <WrapPanel>
                <Button x:Name="ActivateButton" Content="Activate profile" Click="Activate_Click" Style="{StaticResource PrimaryButton}"/>
                <Button Content="Rename" Click="Rename_Click"/>
                <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Panel}" Padding="12" CornerRadius="9" Margin="0,0,0,9">
            <StackPanel>
              <TextBlock Text="Desktop icon layout" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock Text="Monitor configuration" Foreground="{StaticResource Muted}"/>
              <TextBlock x:Name="TopologyText" FontSize="13" Margin="0,4,0,8"/>
              <TextBlock x:Name="LayoutStatusText" Foreground="#A8DFB8" Margin="0,0,0,9"/>
              <WrapPanel>
                <Button x:Name="SaveButton" Content="Save current layout" Click="Save_Click" Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="RestoreButton" Content="Restore layout" Click="Restore_Click"/>
                <Button x:Name="UndoButton" Content="Undo restore" Click="Undo_Click"/>
              </WrapPanel>
              <TextBlock Text="Activate a profile to apply its saved icon positions. Save updates only the active profile. Undo reverses the last restore." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Panel}" Padding="12" CornerRadius="9" Margin="0,0,0,9">
            <StackPanel>
              <TextBlock Text="Saved monitor layouts" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <ItemsControl x:Name="SavedLayoutsList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#344357" BorderThickness="0,0,0,1" Padding="0,7">
                      <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Panel}" Padding="12" CornerRadius="9" Margin="0,0,0,9">
            <StackPanel>
              <TextBlock Text="Coming next" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock Text="Per-profile icon visibility and wallpapers are planned, not active yet." Foreground="{StaticResource Muted}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Settings" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock Text="Application-wide preferences. These apply to every profile." Foreground="{StaticResource Muted}" Margin="0,0,0,20"/>
          <Border Background="{StaticResource Panel}" Padding="12" CornerRadius="9" Margin="0,0,0,9">
            <StackPanel>
              <TextBlock Text="Monitor behavior" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <CheckBox x:Name="AutoRestoreBox" Content="Automatically restore layouts when monitor setup changes" Checked="AutoRestore_Changed" Unchecked="AutoRestore_Changed"/>
              <TextBlock Text="Uses the active profile and the saved layout for the detected monitor configuration. Save is always manual." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Panel}" Padding="12" CornerRadius="9" Margin="0,0,0,9">
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Refresh" Click="Monitors_Refresh_Click" Margin="8,0,0,0"/>
                <TextBlock Text="Monitors" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </DockPanel>
              <TextBlock Text="Ignored displays stay enabled in Windows. Only layout matching is affected. Monitors are currently identified by Windows display names, which can change after reconnecting." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"/>
              <ItemsControl x:Name="MonitorsList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#344357" BorderThickness="0,0,0,1" Padding="0,7">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" FontSize="13"/>
                          <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Content="Ignore" VerticalAlignment="Center" Margin="10,0,0,0" IsChecked="{Binding IsIgnored, Mode=OneTime}" Checked="MonitorIgnore_Changed" Unchecked="MonitorIgnore_Changed"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Panel}" Padding="12" CornerRadius="9" Margin="0,0,0,9">
            <StackPanel>
              <TextBlock Text="Startup &amp; tray" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <TextBlock Text="Run with Windows and minimize to tray are planned for a future version. No startup changes are made by v0.2.4." Foreground="{StaticResource Muted}"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Panel}" Padding="12" CornerRadius="9" Margin="0,0,0,9">
            <StackPanel>
              <TextBlock Text="Data &amp; recovery" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,9"/>
              <TextBlock Text="Profiles, layouts and backups remain in the existing local data folder." Foreground="{StaticResource Muted}" Margin="0,0,0,13"/>
              <WrapPanel>
                <Button Content="Open data folder" Click="OpenDataFolder_Click"/>
                <Button Content="Open logs folder" Click="OpenLogsFolder_Click"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="ActivityPage" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Activity &amp; Logs" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,7"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
          <TextBlock Text="Actions and errors from this session. Full diagnostics are written to disk." Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
          <WrapPanel><Button Content="Open logs folder" Click="OpenLogsFolder_Click"/><Button Content="Open current log" Click="OpenLogFile_Click"/><Button Content="Clear view" Click="ClearActivity_Click"/></WrapPanel>
        </StackPanel>
        <TextBox x:Name="LogText" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#0D131C" Foreground="#CED9E8" BorderBrush="#344155" Padding="11"/>
      </Grid>
      <TextBlock Grid.Row="2" Text="Safe preview · Turn off Windows ‘Auto arrange icons’ · Existing v0.1.3 layouts remain compatible" Foreground="#C1CDDB" FontSize="12" Margin="0,12,0,0"/>
    </Grid>
  </Grid>
</Window>

<Window x:Class="DeskProfiles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskProfiles — Layout Manager" Width="940" Height="650" MinWidth="790" MinHeight="540"
        Background="#121821" Foreground="#EDF2F9" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#1D2632"/>
    <SolidColorBrush x:Key="Muted" Color="#B5C1D1"/>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F3F6FB"/><Setter Property="Background" Value="#354559"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,5"/>
      <Setter Property="MinHeight" Value="27"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.43"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#3977BE"/>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EDF2F9"/><Setter Property="FontSize" Value="13"/></Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#EFF4FC"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#31445F"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2A394D"/></Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#1A2330" BorderBrush="#344155" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,16,10,12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,25">
          <TextBlock Text="DeskProfiles" FontSize="23" FontWeight="SemiBold"/>
          <TextBlock Text="Desktop layout manager · Layout Manager" Margin="0,5,0,0" Foreground="{StaticResource Muted}" FontSize="12"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Button Content="+ New profile" Click="AddProfile_Click" Margin="0,0,0,12"/>
          <Button Content="▦  Desktop Items" Click="ShortcutsPage_Click" Margin="0,0,0,7"/>
          <Button Content="⚙  Settings" Click="SettingsPage_Click" Margin="0,0,0,7"/>
          <Button Content="≡  Activity &amp; Logs" Click="ActivityPage_Click" Margin="0,0,0,12"/>
          <Separator Background="#465469" Margin="0,0,0,12"/>
          <TextBlock Text="SAFE MODE" FontSize="11" FontWeight="Bold" Foreground="#9ECAFA"/>
          <TextBlock Text="Activate restores icon positions if a layout is saved. No desktop files are moved." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="PROFILES" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="4,0,0,12"/>
          <ListBox x:Name="ProfileList" Background="Transparent" BorderThickness="0" SelectionChanged="ProfileList_SelectionChanged" PreviewMouseLeftButtonUp="ProfileList_PreviewMouseLeftButtonUp">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="●" Foreground="#6DD4A4" VerticalAlignment="Center" Visibility="{Binding ActiveVisibility}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="18,14,18,12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel x:Name="ProfilesHeader" Grid.Row="0" Margin="0,0,0,15">
        <TextBlock x:Name="ProfileTitle" Text="Personal" FontSize="23" FontWeight="SemiBold"/>
        <TextBlock x:Name="ProfileSubtitle" Text="Select a profile to see its settings" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
      </StackPanel>
      <ScrollViewer x:Name="ProfilesPage" Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Background="{StaticResource Panel}" Padding="12" CornerRadius="9" Margin="0,0,0,9">
            <StackPanel>
              <TextBlock Text="Profile" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <TextBlock x:Name="ProfileStateText" Foreground="{StaticResource Muted}" Margin="0,0,0,9"/>
              <WrapPanel>
                <Button x:Name="ActivateButton" Content="Activate profile" Click="Activate_Click" Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="RenameButton" Content="Rename" Click="Rename_Click"/>
                <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Panel}" Padding="12" CornerRadius="9" Margin="0,0,0,9">
            <StackPanel>
              <TextBlock Text="Desktop icon layout" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock Text="Monitor configuration" Foreground="{StaticResource Muted}"/>
              <TextBlock x:Name="TopologyText" FontSize="13" Margin="0,4,0,8"/>
              <TextBlock x:Name="LayoutStatusText" Foreground="#A8DFB8" Margin="0,0,0,9"/>
              <WrapPanel>
                <Button x:Name="SaveButton" Content="Save current layout" Click="Save_Click" Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="RestoreButton" Content="Restore layout" Click="Restore_Click"/>
                <Button x:Name="CopyInheritedButton" Content="Copy inherited to this setup" Click="CopyInheritedLayout_Click"/>
                <Button x:Name="UndoButton" Content="Undo restore" Click="Undo_Click"/>
              </WrapPanel>
              <TextBlock Text="Exact setup layouts take priority. On new setups, compatible monitor positions are inherited until you Save or Copy an independent setup layout. Undo reverses the last restore." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Panel}" Padding="12" CornerRadius="9" Margin="0,0,0,9">
            <StackPanel>
              <TextBlock Text="Saved monitor layouts" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock Text="Select a saved layout to manage it. Operations only affect this profile; no desktop shortcuts are deleted." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"/>
              <ListBox x:Name="SavedLayoutsList" Height="165" Background="#121A25" BorderBrush="#3B4C62" SelectionChanged="SavedLayoutsList_SelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#344357" BorderThickness="0,0,0,1" Padding="0,7">
                      <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel Margin="0,9,0,0">
                <Button x:Name="LayoutCopyButton" Content="Copy to current setup" Click="LayoutCopy_Click"/>
                <Button x:Name="LayoutRenameButton" Content="Rename" Click="LayoutRename_Click"/>
                <Button x:Name="LayoutDeleteButton" Content="Delete" Click="LayoutDelete_Click"/>
                <Button x:Name="LayoutResetButton" Content="Reset current to inheritance" Click="LayoutReset_Click"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Panel}" Padding="12" CornerRadius="9" Margin="0,0,0,9">
            <StackPanel>
              <TextBlock Text="Wallpaper" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <CheckBox x:Name="UseWallpaperBox" Content="Use a custom wallpaper for this profile" Checked="WallpaperEnabled_Changed" Unchecked="WallpaperEnabled_Changed" Margin="0,0,0,9"/>
              <TextBlock Text="Selected image" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Browse..." Click="WallpaperBrowse_Click" Margin="8,0,0,0"/>
                <TextBox x:Name="WallpaperPathBox" IsReadOnly="True" VerticalContentAlignment="Center" Background="#131B27" Foreground="#EDF2F9" BorderBrush="#3B4C62" Padding="5,3" MinHeight="27" ToolTip="Image path; the original file must remain accessible"/>
              </DockPanel>
              <TextBlock Text="Style" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
              <ComboBox x:Name="WallpaperStyleBox" SelectionChanged="WallpaperStyle_Changed" Width="155" HorizontalAlignment="Left" Background="#FFFFFF" Foreground="#172536" Margin="0,0,0,10">
                <ComboBox.ItemContainerStyle>
                  <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="#172536"/>
                    <Setter Property="Background" Value="#FFFFFF"/>
                  </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBoxItem Content="Fill"/><ComboBoxItem Content="Fit"/><ComboBoxItem Content="Stretch"/><ComboBoxItem Content="Center"/><ComboBoxItem Content="Tile"/><ComboBoxItem Content="Span"/>
              </ComboBox>
              <WrapPanel>
                <Button Content="Apply now" Click="WallpaperApply_Click" Style="{StaticResource PrimaryButton}"/>
                <Button Content="Clear image" Click="WallpaperClear_Click"/>
              </WrapPanel>
              <TextBlock Text="Activating a profile applies its wallpaper across the Windows desktop, regardless of monitor setup. Disabling this option leaves the current wallpaper unchanged." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Panel}" Padding="12" CornerRadius="9" Margin="0,0,0,9">
            <StackPanel>
              <TextBlock Text="Global keyboard shortcut" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock Text="Activate this profile from any app while DeskProfiles runs." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10"/>
              <WrapPanel VerticalAlignment="Center">
                <TextBlock x:Name="HotkeyText" Text="None" VerticalAlignment="Center" MinWidth="165" FontWeight="SemiBold"/>
                <Button x:Name="HotkeyRecordButton" Content="Record shortcut" Click="HotkeyRecord_Click"/>
                <Button Content="Clear" Click="HotkeyClear_Click"/>
              </WrapPanel>
              <TextBlock x:Name="HotkeyHint" Text="Shortcut must include Ctrl, Alt, or Win. Shift alone is not sufficient." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="ShortcutsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Desktop Items · Visibility" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock Text="Real folders are listed first. Shortcut icons: ↗ app/file, ▣ folder link, ◎ web. Original Desktop always displays its real contents." Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>
          <Border Background="{StaticResource Panel}" Padding="12" CornerRadius="9" Margin="0,0,0,9">
            <StackPanel>
              <Separator Margin="0,14,0,12"/>
              <TextBlock Text="Real folders · Original Desktop" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
              <TextBlock Text="These are actual folders, not shortcuts. They appear when you select Original Desktop; other profiles contain their assigned shortcuts." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="160" Background="#121A25" Margin="0,0,0,6"><StackPanel x:Name="OriginalFoldersPanel" Margin="4"/></ScrollViewer>
              <TextBlock x:Name="OriginalFoldersStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,7"/>
              <TextBlock Text="Desktop shortcut library" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock Text="Managed shortcuts follow profile assignments. Unmanaged desktop items stay visible in all profiles." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,9"/>
              <WrapPanel Margin="0,0,0,8">
                <Button Content="Scan desktop..." Click="ShortcutScan_Click"/>
                <Button Content="Import .lnk / .url" Click="ShortcutImport_Click"/>
                <Button Content="Shortcut to folder..." Click="ShortcutFolder_Click"/>
              </WrapPanel>
              <TextBlock Text="Shortcuts · Select profiles" FontWeight="SemiBold" Margin="0,6,0,6"/>
              <TextBlock Text="Check the profiles where each shortcut should appear. Changes save immediately; activation is not required to edit." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,7"/>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="360" Background="#121A25" Margin="0,0,0,7">
                <StackPanel x:Name="ShortcutMatrix" Margin="4"/>
              </ScrollViewer>
              <WrapPanel Margin="0,0,0,8">
                <Button Content="Refresh desktop shortcuts" Click="ShortcutInventoryRefresh_Click"/>
                <Button Content="Restore all managed shortcuts" Click="ShortcutsRestoreAll_Click"/>
              </WrapPanel>
              <TextBlock Text="Folders: open Original Desktop to access your actual folders. Shortcut entries (↗) are separate .lnk/.url files. Unmanaged = visible in every profile. On the first visibility edit, DeskProfiles asks permission to manage the original desktop shortcut. Real files and folders never move." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
              <StackPanel Visibility="Collapsed">
              <ListBox x:Name="ShortcutList" Height="130" Background="#121A25" BorderBrush="#3B4C62" SelectionChanged="ShortcutList_SelectionChanged" DisplayMemberPath="Description"/>
              <WrapPanel Margin="0,9,0,0">
                <Button x:Name="ShortcutAssignButton" Click="ShortcutAssign_Click" Content="Show in this profile"/>
                <Button x:Name="ShortcutSharedButton" Click="ShortcutShared_Click" Content="Set shared"/>
                <Button x:Name="ShortcutManageButton" Content="Manage selected desktop shortcut" Click="ShortcutManage_Click"/>
                <Button Content="Remove from library" Click="ShortcutRemove_Click"/>
              </WrapPanel>
              <TextBlock x:Name="ShortcutStatusText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
              </StackPanel>
              <TextBlock x:Name="ShortcutInventoryStatus" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
              <Separator Visibility="Collapsed" Margin="0,16,0,13"/>
              <TextBlock Visibility="Collapsed" Text="Shared desktop folders (whole-Desktop experiment)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,7"/>
              <TextBlock Visibility="Collapsed" Text="Enroll real folders from your original Desktop. They remain in place; safe folder junctions are shown in selected profiles. Shared by default. Changes apply on the next profile switch." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,9"/>
              <Button Visibility="Collapsed" Content="Add a folder from original Desktop..." Click="FolderInventory_Click" HorizontalAlignment="Left" Margin="0,0,0,9"/>
              <ScrollViewer Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="210" Background="#121A25" Margin="0,0,0,7">
                <StackPanel x:Name="FolderMatrix" Margin="4"/>
              </ScrollViewer>
              <TextBlock Visibility="Collapsed" x:Name="FolderInventoryStatus" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Settings" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock Text="Application-wide preferences. These apply to every profile." Foreground="{StaticResource Muted}" Margin="0,0,0,20"/>
          <Border Background="{StaticResource Panel}" Padding="12" CornerRadius="9" Margin="0,0,0,9">
            <StackPanel>
              <TextBlock Text="Desktop shortcut management" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <CheckBox x:Name="ShortcutSwitchingBox" Content="Enable shortcut visibility switching (diagnostic toggle)" Checked="ShortcutSwitching_Changed" Unchecked="ShortcutSwitching_Changed"/>
              <TextBlock Text="Turn this OFF to test layouts and wallpapers without adding/removing shortcut files. Assignments and catalog are preserved. Turning it on does not immediately reconcile; switching profiles applies it." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,12"/>
              <CheckBox x:Name="FolderStagingBox" Content="Experimental: stage hidden shortcuts in a private folder" Checked="FolderStaging_Changed" Unchecked="FolderStaging_Changed"/>
              <TextBlock Text="Reversibly moves managed .lnk/.url files to a private holding folder instead of deleting/re-copying them. Existing backups are kept. Explorer still needs to update its icon view; this is a test, not a guaranteed speed improvement. Takes effect on the next profile switch." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,12"/>
              <CheckBox x:Name="WholeDesktopBox" Content="EXPERIMENT: switch Windows Desktop folder as a unit (system-wide)" Checked="WholeDesktop_Changed" Unchecked="WholeDesktop_Changed"/>
              <Button Content="Restore original Windows Desktop now" Click="RestoreOriginalDesktop_Click" Margin="0,8,0,4" HorizontalAlignment="Left"/>
              <TextBlock Text="WARNING: While enabled, ordinary files from your original Desktop will NOT be visible (they remain untouched). Only enrolled shortcuts appear in private profile folders. Original Desktop is a protected profile containing your real files and folders. Other programs see a different Desktop path. Disable this test or exit DeskProfiles to restore. Do not use with OneDrive Desktop backup." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,12"/>
              <CheckBox x:Name="AutoManageShortcutBox" Content="Automatically assign new desktop shortcuts to active profile" Checked="AutoManageShortcuts_Changed" Unchecked="AutoManageShortcuts_Changed"/>
              <TextBlock Text="Only NEW .lnk/.url shortcuts on your personal Desktop, after DeskProfiles starts. Existing shortcuts require explicit Manage. Original shortcut backups are retained; targets never move." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Panel}" Padding="12" CornerRadius="9" Margin="0,0,0,9">
            <StackPanel>
              <TextBlock Text="Monitor behavior" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <CheckBox x:Name="AutoRestoreBox" Content="Automatically restore layouts when monitor setup changes" Checked="AutoRestore_Changed" Unchecked="AutoRestore_Changed"/>
              <TextBlock Text="Uses the active profile and the saved layout for the detected monitor configuration. Save is always manual." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Panel}" Padding="12" CornerRadius="9" Margin="0,0,0,9">
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Refresh" Click="Monitors_Refresh_Click" Margin="8,0,0,0"/>
                <TextBlock Text="Monitors" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </DockPanel>
              <TextBlock Text="Ignored displays stay enabled in Windows. Only layout matching is affected. Monitors are currently identified by Windows display names, which can change after reconnecting." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"/>
              <ItemsControl x:Name="MonitorsList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#344357" BorderThickness="0,0,0,1" Padding="0,7">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" FontSize="13"/>
                          <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Content="Ignore" VerticalAlignment="Center" Margin="10,0,0,0" IsChecked="{Binding IsIgnored, Mode=OneTime}" Checked="MonitorIgnore_Changed" Unchecked="MonitorIgnore_Changed"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Panel}" Padding="12" CornerRadius="9" Margin="0,0,0,9">
            <StackPanel>
              <TextBlock Text="Startup &amp; tray" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <CheckBox x:Name="StartWithWindowsBox" Content="Start DeskProfiles when I sign in to Windows" Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed"/>
              <TextBlock Text="Starts hidden in the system tray, with profile shortcuts available. Closing the window still minimizes to tray; right-click the tray icon to exit." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Panel}" Padding="12" CornerRadius="9" Margin="0,0,0,9">
            <StackPanel>
              <TextBlock Text="Data &amp; recovery" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,9"/>
              <TextBlock Text="Profiles, layouts and backups remain in the existing local data folder." Foreground="{StaticResource Muted}" Margin="0,0,0,13"/>
              <WrapPanel>
                <Button Content="Open data folder" Click="OpenDataFolder_Click"/>
                <Button Content="Open logs folder" Click="OpenLogsFolder_Click"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="ActivityPage" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Activity &amp; Logs" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,7"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
          <TextBlock Text="Actions and errors from this session. Full diagnostics are written to disk." Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
          <WrapPanel><Button Content="Open logs folder" Click="OpenLogsFolder_Click"/><Button Content="Open current log" Click="OpenLogFile_Click"/><Button Content="Clear view" Click="ClearActivity_Click"/></WrapPanel>
        </StackPanel>
        <TextBox x:Name="LogText" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#0D131C" Foreground="#CED9E8" BorderBrush="#344155" Padding="11"/>
      </Grid>
      <TextBlock Grid.Row="2" Text="Whole-Desktop mode: restores Original Desktop on exit · Disable Windows Auto arrange · Layouts are saved per monitor setup" Foreground="#C1CDDB" FontSize="12" Margin="0,12,0,0"/>
    </Grid>
  

</Grid>
</Window>
